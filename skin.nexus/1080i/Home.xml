<?xml version="1.0" encoding="UTF-8"?>
<window id="0">
  <defaultcontrol always="true">9101</defaultcontrol>
  <backgroundcolor>FF09090C</backgroundcolor>
  <animation effect="fade" time="260">WindowOpen</animation>
