<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="skin.nexus" name="Nexus" version="0.2.0" provider-name="stewykes-source">
  <requires>
    <import addon="xbmc.gui" version="5.17.0"/>
  </requires>
  <extension point="xbmc.gui.skin" debugging="false">
    <res width="1920" height="1080" aspect="16:9" default="true" folder="1080i"/>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Nexus TV — an Apple TV-inspired Kodi interface</summary>
    <description lang="en_GB">A clean, cinematic, remote-first interface for Kodi. Playback remains powered by Kodi and compatible video add-ons.</description>
    <platform>all</platform>
    <license>MIT</license>
    <source>https://github.com/stewykes-source/nexus-tv-kodi</source>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.png</fanart>
    </assets>
  </extension>
</addon>
